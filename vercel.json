{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
  {
    "source": "/api/auth/session",
    "destination": "/api/notes?authAction=session"
  },
  {
    "source": "/api/auth/logout",
    "destination": "/api/notes?authAction=logout"
  },
  {
    "source": "/api/notes/:id",
    "destination": "/api/notes?noteId=:id"
  }
],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
